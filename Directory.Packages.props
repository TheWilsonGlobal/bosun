<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- FluentAssertions 8.x moved to a commercial licence; stay on the last Apache-2.0 line. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <!-- Phase 5 document extraction: PdfPig (Apache-2.0) for text + letter positions and the PDF builder used by the fixture generator;
         PDFtoImage (MIT; pulls SkiaSharp MIT + PDFium binaries BSD-3/Apache-2.0) for page -> PNG. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="PDFtoImage" Version="5.4.0" />
    <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
  </ItemGroup>
</Project>
