{
  "version": 1,
  "title": "Engine room mimic",
  "description": "Data-driven layout: the frontend draws shapes (in order) and then places one live widget per binding. A widget shows the live value of its tag; colour it by the active alarm (unacknowledged / acknowledged) of that tag and grey it when quality is stale. Coordinates are in viewBox units.",
  "viewBox": {
    "width": 1200,
    "height": 760
  },
  "roles": {
    "frame": "outer border",
    "panel": "grouping box with a caption",
    "equipment": "engine / turbocharger body",
    "cylinder": "one cylinder of the main engine",
    "exhaust": "exhaust gas pipe",
    "pipe": "liquid pipe",
    "caption": "small text",
    "title": "page title",
    "label": "plain text"
  },
  "kinds": {
    "value": "number with unit",
    "bar": "horizontal or vertical level bar (min..max from tags[tag].rangeLow/rangeHigh)",
    "tank": "vertical tank with a fill level in percent",
    "navigation": "position, heading, speed from the NMEA feed (no tag)"
  },
