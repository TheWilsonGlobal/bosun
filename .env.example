# ---- Core AI provider & secrets (user-supplied) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_LLM_API_KEY=

# ---- Embedding subsystem ----
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_API_KEY=
# GEMINI_EMBEDDING_API_KEY=
EMBEDDING_DIMS=768

# ---- App (plan.md section 10) ----
BACKEND_PORT=5480
FRONTEND_PORT=5481
ADMIN_PORT=5482
VITE_API_URL=http://127.0.0.1:5480
DB_PROVIDER=sqlite
DB_CONNECTION=Data Source=data/db/bosun.db
SIM_MODBUS_PORT=5483
SIM_NMEA_PORT=5484
MCP_PORT=5485
MCP_TOKEN=dev-mcp-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Optional (backend) ----
# Second user holding the "approver" role (second approval of SIL/ESD change sets). In Development the backend adds a
# documented dev-only default when these are empty; in any other environment set both to real values.
APPROVER_USERNAME=
APPROVER_PASSWORD=

# Prometheus scrape token (32+ chars). Unset = GET /metrics answers 404. Send it as `Authorization: Bearer <token>`.
# METRICS_TOKEN=
